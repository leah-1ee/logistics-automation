[Unit]
Description=LOPS offline device agent
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/logistics-automation
EnvironmentFile=/home/pi/logistics-automation/.env
ExecStart=/usr/local/bin/node /home/pi/logistics-automation/dist/src/device/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
