+export function connection(db: Db): Tx {
+  const native = db.em.fork().getConnection();
+  return new Proxy(native, { get(target, key) {
+    if(key==='execute')return (sql:string,...args:any[])=>observedSql(sql,()=> (target.execute as any)(sql,...args));
