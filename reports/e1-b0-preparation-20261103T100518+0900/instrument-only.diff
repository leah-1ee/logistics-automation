+};
+
+export class Recorder {
+  readonly processIdentity = `${process.pid}-${randomUUID()}`;
+  private queue:string[]=[];
+  private queuedBytes=0;
+  private sequence=0;
+  private bytes=0;
+  private acceptedBytes=0;
